{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "slidev": {
        "type": "local",
        "command": ["npm", "exec", "--", "slidev", "mcp", "slides.md"],
        "cwd": "."
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.82",
          "--browser",
          "chrome",
          "--viewport-size",
          "1280x720"
        ]
      }
    }
  }
}
